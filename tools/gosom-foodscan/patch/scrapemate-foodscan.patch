--- a/adapters/fetchers/jshttp/foodscan_patch_internal_test.go
+++ b/adapters/fetchers/jshttp/foodscan_patch_internal_test.go
@@ -0,0 +1,61 @@
+package jshttp
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+type recoveryRuntime struct {
+	page               page
+	recreatePageErr    error
+	recreateContextErr error
+	recreateBrowserErr error
+}
+
+func (r *recoveryRuntime) pageCount() int             { return 1 }
+func (r *recoveryRuntime) closeExtraPages() error     { return nil }
+func (r *recoveryRuntime) closeBrowser() error        { return nil }
+func (r *recoveryRuntime) primaryPage() (page, error) { return r.page, nil }
+func (r *recoveryRuntime) recreatePage() error        { return r.recreatePageErr }
+func (r *recoveryRuntime) recreateContext() error     { return r.recreateContextErr }
+func (r *recoveryRuntime) recycleIfNeeded() error     { return nil }
+func (r *recoveryRuntime) recreateBrowser() error {
+	if r.recreateBrowserErr == nil {
+		r.page = &fakePage{id: 99}
+	}
+	return r.recreateBrowserErr
+}
+
+func TestFoodScanOpenPageIsNotClosed(t *testing.T) {
+	if normalizeClosedState(false) {
+		t.Fatal("an open Playwright page must be considered open")
+	}
+	if !normalizeClosedState(true) {
+		t.Fatal("a closed Playwright page must be considered closed")
+	}
+}
+
+func TestFoodScanBrowserRecoveryReturnsPrimaryPage(t *testing.T) {
+	runtime := &recoveryRuntime{
+		page:               &fakePage{id: 1, closed: true},
+		recreatePageErr:    errors.New("page recreation failed"),
+		recreateContextErr: errors.New("context recreation failed"),
+	}
+	slot := &sessionSlot{runtime: runtime}
+	got, err := slot.acquirePage(context.Background())
+	if err != nil {
+		t.Fatalf("acquirePage returned error: %v", err)
+	}
+	if got == nil {
+		t.Fatal("successful browser recovery returned (nil, nil)")
+	}
+}
+
+func TestFoodScanChromiumArgsExcludeSingleProcess(t *testing.T) {
+	for _, argument := range chromiumArgs() {
+		if argument == "--single-process" {
+			t.Fatal("--single-process crashes Chromium on Windows and must not be present")
+		}
+	}
+}
